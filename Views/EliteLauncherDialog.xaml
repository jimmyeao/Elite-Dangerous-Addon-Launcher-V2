<Window x:Class="Elite_Dangerous_Addon_Launcher_V2.Views.EliteLauncherDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding DialogTitle}"
        Width="450"
        SizeToContent="Height"
        MinHeight="450"
        MaxHeight="700"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        Background="{DynamicResource MaterialDesign.Brush.Background}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="12"
        FontFamily="{materialDesign:MaterialDesignFont}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <materialDesign:DialogHost Margin="0,0,0,-16">
        <materialDesign:Card Margin="16">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="{Binding MainMessage}"
                           TextWrapping="Wrap"
                           Style="{DynamicResource MaterialDesignBody1TextBlock}"
                           Margin="0,0,0,16"/>

                <TextBlock Grid.Row="1"
                           Visibility="{Binding ShowCurrentConfig, Converter={StaticResource BooleanToVisibilityConverter}}"
                           Text="{Binding CurrentConfigText}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource MaterialDesignValidationErrorBrush}"
                           Style="{DynamicResource MaterialDesignCaptionTextBlock}"
                           Margin="0,0,0,12"/>

                <TextBlock Grid.Row="2"
                           Visibility="{Binding ShowSteamWarning, Converter={StaticResource BooleanToVisibilityConverter}}"
                           Text="Note: Command-line arguments may not work&#x0a;with alternate launchers. For VR mode,&#x0a;consider using the Standard installation."
                           TextWrapping="Wrap"
                           Foreground="Orange"
                           Style="{DynamicResource MaterialDesignBody1TextBlock}"
                           Margin="0,0,0,16"/>

                <StackPanel Grid.Row="3" Orientation="Vertical">
                    <Button x:Name="StandardButton"
                            Content="Standard Installation (Scan Computer)"
                            Command="{Binding SelectStandardCommand}"
                            Margin="0,4"
                            Style="{DynamicResource MaterialDesignRaisedButton}"
                            materialDesign:ButtonAssist.CornerRadius="5"
                            HorizontalAlignment="Stretch"/>

                    <Button x:Name="SteamButton"
                            Content="Steam Version"
                            Command="{Binding SelectSteamCommand}"
                            Margin="0,4"
                            Style="{DynamicResource MaterialDesignRaisedButton}"
                            materialDesign:ButtonAssist.CornerRadius="5"
                            HorizontalAlignment="Stretch"/>

                    <Button x:Name="EpicButton"
                            Content="Epic Games Launcher"
                            Command="{Binding SelectEpicCommand}"
                            Margin="0,4"
                            Style="{DynamicResource MaterialDesignRaisedButton}"
                            materialDesign:ButtonAssist.CornerRadius="5"
                            HorizontalAlignment="Stretch"/>

                    <Button x:Name="LegendaryButton"
                            Content="Legendary Launcher"
                            Command="{Binding SelectLegendaryCommand}"
                            Margin="0,4"
                            Style="{DynamicResource MaterialDesignRaisedButton}"
                            materialDesign:ButtonAssist.CornerRadius="5"
                            HorizontalAlignment="Stretch"/>

                    <Button x:Name="BrowseButton"
                            Content="Browse Manually..."
                            Command="{Binding BrowseCommand}"
                            Margin="0,4"
                            Style="{DynamicResource MaterialDesignRaisedButton}"
                            materialDesign:ButtonAssist.CornerRadius="5"
                            HorizontalAlignment="Stretch"/>
                </StackPanel>

                <!-- Launch Options -->
                <materialDesign:Card Grid.Row="4"
                                    Background="{DynamicResource MaterialDesignBackground.Brush.Background}"
                                    Margin="0,16,0,16"
                                    Padding="8">
                    <StackPanel>
                        <TextBlock Text="Launch Options"
                                   FontWeight="Bold"
                                   Style="{DynamicResource MaterialDesignBody1TextBlock}"
                                   Margin="8,8,8,16"/>

                        <CheckBox Content="Auto Run (automatically launch the game)"
                                  IsChecked="{Binding UseAutoRun, Mode=TwoWay}"
                                  Margin="8,4"/>

                        <CheckBox Content="Auto Quit (close launcher when game exits)"
                                  IsChecked="{Binding UseAutoQuit, Mode=TwoWay}"
                                  Margin="8,4"/>

                        <CheckBox Content="VR Mode"
                                  IsChecked="{Binding UseVrMode, Mode=TwoWay}"
                                  Margin="8,4"/>
                    </StackPanel>
                </materialDesign:Card>

                <StackPanel Grid.Row="5"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom">
                    <Button Content="Cancel"
                            Click="CancelButton_Click"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            materialDesign:ButtonAssist.CornerRadius="5"
                            Margin="8,0,0,0"/>

                    <Button Content="OK"
                            Click="OkButton_Click"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            materialDesign:ButtonAssist.CornerRadius="5"
                            IsDefault="True"
                            Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </materialDesign:Card>
    </materialDesign:DialogHost>
</Window>
